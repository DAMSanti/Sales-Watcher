# Variables del despliegue. Copiar a deploy/.env EN EL SERVIDOR y rellenar.
# Este fichero sí se versiona; el .env con los valores reales, no.

DOMINIO=sales-watcher.duckdns.org

# Base de datos. Contraseña larga y propia: no reutilizar la de desarrollo,
# que está en el repositorio público como valor por defecto.
POSTGRES_USER=sw
POSTGRES_PASSWORD=
POSTGRES_DB=sales_watcher

# Almacenamiento de evidencias. El nombre del bucket ES parte de la URL
# pública, porque MinIO se direcciona por ruta: cambiarlo obliga a cambiar
# también el `location` del nginx de entrada.
S3_BUCKET=evidencias
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Firma de sesión. Cambiarla invalida todos los tokens emitidos.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Comportamiento
ACCION_ESTANCADA_DIAS=14
CHECKLIST_ACTIVO=false
VIDEO_ALTURA=720
VIDEO_MAX_INTENTOS=3
EVIDENCIA_VIDEO_MAX_BYTES=26214400
EVIDENCIA_VIDEO_MAX_SEGUNDOS=60
URL_SUBIDA_VIDEO_MINUTOS=45
CIERRE_JORNADA_HORA=21:00
ZONA_HORARIA_DEFECTO=Europe/Madrid

# syntax=docker/dockerfile:1
#
# Frontends estáticos (app de campo y backoffice).
#
# Un solo Dockerfile para los dos: cambia el paquete que se construye y la
# configuración de nginx. Duplicarlo garantizaría que uno se quedase atrás.

ARG APP=field

FROM node:22-alpine AS build
ARG APP
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

# `tsconfig.base.json` va aquí y no con el código: todos los paquetes lo
# heredan con `extends`, y sin él `tsc` falla con un TS5083 que no menciona
# el fichero que falta sino el proyecto que no compila.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/${APP}/package.json apps/${APP}/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
RUN pnpm install --frozen-lockfile --filter @sw/${APP}...

COPY packages packages
COPY apps/${APP} apps/${APP}
# El `.env` de la raíz no viaja a la imagen (está en .dockerignore). Vite lee
# de él la base del backoffice, así que se pasa por argumento de build.
ARG BASE_BACKOFFICE
ENV BASE_BACKOFFICE=${BASE_BACKOFFICE}
RUN pnpm --filter @sw/shared build && pnpm --filter @sw/${APP} build

FROM nginx:alpine AS runtime
ARG APP
ARG BASE_BACKOFFICE
# El backoffice se construye con `base: "/gestion/"`, así que sus assets se
# referencian como `/gestion/assets/...`. El proxy inverso no stripea el
# prefijo, y los ficheros tienen que vivir donde la ruta los busca.
# Para la app de campo (base `/`), se copian a la raíz como siempre.
RUN if [ "$APP" = "backoffice" ] && [ -n "$BASE_BACKOFFICE" ]; then \
      mkdir -p "/usr/share/nginx/html${BASE_BACKOFFICE}"; \
    fi
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html${BASE_BACKOFFICE:-/}
# Cada app necesita su propio nginx: la de campo sirve desde / y el backoffice
# desde /gestion/. Sin esto, try_files no encuentra los assets y devuelve HTML.
COPY deploy/nginx-spa.conf deploy/nginx-spa-backoffice.conf /tmp/
RUN if [ "$APP" = "backoffice" ]; then \
      cp /tmp/nginx-spa-backoffice.conf /etc/nginx/conf.d/default.conf; \
    else \
      cp /tmp/nginx-spa.conf /etc/nginx/conf.d/default.conf; \
    fi && rm -f /tmp/nginx-spa*.conf
EXPOSE 80

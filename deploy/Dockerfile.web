# syntax=docker/dockerfile:1
#
# Frontends estáticos (app de campo y backoffice).
#
# Un solo Dockerfile para los dos: cambia el paquete que se construye y la
# configuración de nginx. Duplicarlo garantizaría que uno se quedase atrás.

ARG APP=field

FROM node:22-alpine AS build
ARG APP
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/${APP}/package.json apps/${APP}/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
RUN pnpm install --frozen-lockfile --filter @sw/${APP}...

COPY packages packages
COPY apps/${APP} apps/${APP}
# El `.env` de la raíz no viaja a la imagen (está en .dockerignore). Vite lee
# de él la base del backoffice, así que se pasa por argumento de build.
ARG BASE_BACKOFFICE
ENV BASE_BACKOFFICE=${BASE_BACKOFFICE}
RUN pnpm --filter @sw/shared build && pnpm --filter @sw/${APP} build

FROM nginx:alpine AS runtime
ARG APP
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

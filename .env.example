# Copiar a .env y ajustar. Nunca commitear .env.

NODE_ENV=development

# ── Puertos ──────────────────────────────────────────────────────
# Bloque contiguo 3900-3907, elegido para no chocar con los puertos
# habituales (3000, 5173, 5432, 9000). Si alguno colisiona, cambiarlo aquí
# basta: nada los tiene cableados.
PORT=3900
PUERTO_FIELD=3901
PUERTO_BACKOFFICE=3902
PUERTO_FIELD_PREVIEW=3903
PUERTO_BACKOFFICE_PREVIEW=3904
POSTGRES_PORT=3905
MINIO_PORT=3906
MINIO_CONSOLE_PORT=3907

# ── Base de datos ────────────────────────────────────────────────
POSTGRES_USER=sw
POSTGRES_PASSWORD=sw_dev_password
POSTGRES_DB=sales_watcher
DATABASE_URL=postgresql://sw:sw_dev_password@localhost:3905/sales_watcher

# ── Ciclo de acciones ────────────────────────────────────────────
# Días tras los que una acción abierta se marca como estancada. No la cierra:
# solo la sube en el panel del FSM. Las acciones nunca caducan solas.
ACCION_ESTANCADA_DIAS=14

# ── Autenticación ────────────────────────────────────────────────
# En producción: secreto largo y aleatorio, rotable, nunca en el repositorio.
JWT_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=30d

# ── Almacenamiento de fotos (S3 / MinIO / R2) ────────────────────
S3_ENDPOINT=http://localhost:3906
S3_REGION=us-east-1
S3_BUCKET=sales-watcher-fotos
S3_ACCESS_KEY_ID=sw_minio_access
S3_SECRET_ACCESS_KEY=sw_minio_secret

# ── Reglas de negocio configurables ──────────────────────────────
# Hora local de cierre de jornada: convierte visitas Pendiente en No realizada
# y cierra la ventana de justificación (SPECS §5.5). Pendiente de confirmar con negocio.
CIERRE_JORNADA_HORA=21:00
ZONA_HORARIA_DEFECTO=Europe/Madrid

# Retención de fotos en días. Pendiente de decidir (ROADMAP fase 0).
# VACÍO = conservar indefinidamente. Ojo: vacío NO es cero; poner 0 aquí
# no borra nada, pero confundirlo con "0 días" sí lo haría.
RETENCION_FOTOS_DIAS=

# Límite por fotografía. Si llega algo mayor, la compresión del cliente falló.
FOTO_MAX_BYTES=5242880

# Validez de las URLs firmadas, en minutos.
URL_SUBIDA_MINUTOS=15
URL_DESCARGA_MINUTOS=5

# Horas tras las que una subida sin confirmar se considera abandonada.
FOTO_RESERVA_CADUCA_HORAS=48

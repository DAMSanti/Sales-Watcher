# Normaliza finales de línea: LF en el repositorio, nativo en el disco.
# Sin esto, un equipo mixto Windows/macOS genera diffs completos por fichero
# cada vez que alguien guarda.
* text=auto eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# El lockfile es generado: colapsarlo en las revisiones de código.
pnpm-lock.yaml linguist-generated=true -diff

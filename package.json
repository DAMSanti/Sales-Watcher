{
  "name": "sales-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Registro y supervisión de visitas comerciales en punto de venta",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sw/db generate",
    "db:migrate": "pnpm --filter @sw/db migrate",
    "db:seed": "pnpm --filter @sw/db seed",
    "db:studio": "pnpm --filter @sw/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "db:verify": "node scripts/verificar-seed.mjs",
    "db:pruebas": "pnpm --filter @sw/db pruebas",
    "db:acciones": "node scripts/ejercitar-acciones.mjs",
    "api:acciones": "node scripts/probar-api-acciones.mjs",
    "api:resultados": "node scripts/probar-api-resultados.mjs",
    "api:video": "node scripts/probar-video.mjs",
    "api:visitas": "node scripts/probar-visita-ruta.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@types/node": "^22.7.5",
    "postgres": "^3.4.5",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
